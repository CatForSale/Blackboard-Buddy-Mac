# Copy this file to ".env" and fill in your key.
# Get one at https://console.anthropic.com  (Settings > API keys)
ANTHROPIC_API_KEY=

# Optional settings
BB_URL=https://blackboard.uwe.ac.uk
LOOKAHEAD_DAYS=45     # how far ahead to show deadlines
NOTES_DAYS=14         # make notes from materials added in the last N days
NOTES_PER_RUN=8       # max new study notes per sync (controls cost)
PLANS_PER_RUN=6       # max assignment plans per sync
AI_EFFORT=medium      # low | medium | high  (higher = better but slower and pricier)
