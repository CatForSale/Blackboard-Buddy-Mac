<?xml version="1.0" encoding="utf-8"?>
<!-- Windows marks every file that comes out of a downloaded zip as having come from the internet,
     and .NET then refuses to load one, so the app died on startup for anyone who downloaded it
     rather than built it: "Failed to resolve Python.Runtime.Loader.Initialize". These are our own
     files, sitting in our own folder, next to our own exe. Say so, and the app starts. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
  </startup>
  <runtime>
    <loadFromRemoteSources enabled="true"/>
  </runtime>
</configuration>
